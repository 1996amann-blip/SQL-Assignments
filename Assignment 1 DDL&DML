create database School;
use School;
#DDL
#1 Create Tabe Student
create table Student (
sid varchar(10) primary key,
sname varchar(50),
sage int(3),
semail varchar(100) unique
);

#2 Create Table Course
create table Course (
cid varchar(10),
cname varchar(50),
cduration int
);

#3 Add Column phone_number to the Student table
alter table Student add column (sphone_no varchar(15));

#4 Change datatype of age from INT to SMALLINT 
alter table Student modify column sage smallint;

#5 Rename Table Student to Students 
rename table Student to Students;

#6 Remove Column Duration from table Course
alter table Course drop column cduration;

